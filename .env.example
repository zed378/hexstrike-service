# ============================================================================
# HexStrike AI — contoh konfigurasi environment
# Salin ke `.env` lalu sesuaikan:  cp .env.example .env
# (.env sudah di-ignore oleh .dockerignore & .gitignore)
#
# Tidak semua variabel wajib diisi — kolom "dipakai oleh" menandai konteksnya.
# Nilai yang dibiarkan default cukup dihapus/dibiarkan.
# ============================================================================

# ----------------------------------------------------------------------------
# Registry & image (dipakai: docker-compose, deploy/docker-compose.vps.yml)
# ----------------------------------------------------------------------------
# Default image = Docker Hub zed378/hexstrike-ai. Override bila mirror ke registry privat.
REGISTRY_IMAGE=zed378/hexstrike-ai
IMAGE_TAG=latest

# ----------------------------------------------------------------------------
# Port publish (dipakai: docker-compose, vps compose)
# ----------------------------------------------------------------------------
HEXSTRIKE_PORT=8888              # Flask API server (service hexstrike-server)
CODESCAN_WEBHOOK_PORT=9001       # code-scan webhook di dev compose
WEBHOOK_PORT=9000                # pentest webhook di dev compose / port webhook di container
CODESCAN_PORT=9001               # code-scan webhook di VPS compose
PENTEST_PORT=9000                # pentest webhook di VPS compose

# ----------------------------------------------------------------------------
# HexStrike server (dipakai: agent, hexstrike_ci.py, webhook)
# ----------------------------------------------------------------------------
HEXSTRIKE_SERVER=http://hexstrike-server:8888

# ----------------------------------------------------------------------------
# LLM lokal OpenAI-compatible / vLLM (dipakai: agent, --use-llm di ci/webhook)
# Dari dalam compose, host mesin bisa diakses lewat host.docker.internal.
# ----------------------------------------------------------------------------
OPENAI_BASE_URL=http://host.docker.internal:8000/v1
OPENAI_API_KEY=EMPTY
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# ----------------------------------------------------------------------------
# Perilaku agent (dipakai: hexstrike_openai_agent.py)
# ----------------------------------------------------------------------------
HEXSTRIKE_MAX_STEPS=20
HEXSTRIKE_TEMPERATURE=0.2
HEXSTRIKE_MAX_TOOL_CHARS=12000
# Opsional:
#HEXSTRIKE_SYSTEM_PROMPT=You are HexStrike, an autonomous security-testing assistant...
#HEXSTRIKE_MCP_SCRIPT=/opt/hexstrike-ai/hexstrike_mcp.py
#NO_COLOR=1

# ----------------------------------------------------------------------------
# Scanner CI/CD (dipakai: hexstrike_ci.py)
# ----------------------------------------------------------------------------
HEXSTRIKE_FAIL_ON=high           # none|info|low|medium|high|critical
HEXSTRIKE_PENTEST_PROFILE=quick  # quick|full
HEXSTRIKE_USE_LLM=false          # true = tambahkan ringkasan AI (vLLM) ke laporan
#HEXSTRIKE_REPORT_DIR=hexstrike-reports

# ----------------------------------------------------------------------------
# Webhook service (dipakai: hexstrike_webhook.py — image pre/post-deploy)
# ----------------------------------------------------------------------------
# WAJIB salah satu agar endpoint /trigger & /scan/code aktif:
WEBHOOK_TOKEN=                   # token header X-Webhook-Token (mis. `openssl rand -hex 24`)
WEBHOOK_HMAC_SECRET=             # alternatif: verifikasi X-Hub-Signature-256 (gaya GitHub)
HEXSTRIKE_AUTOSTART_SERVER=1     # 1 = webhook menyalakan hexstrike_server.py otomatis
HEXSTRIKE_MAX_UPLOAD_MB=300      # batas ukuran arsip upload ke /scan/code
HEXSTRIKE_DEFAULT_FAIL_ON=high   # ambang default bila request tidak menyertakan fail_on
#HEXSTRIKE_REPORT_ROOT=hexstrike-reports
# SQLite untuk dashboard metrik (di-mount ke volume persistent di image webhook).
# Default di image: /opt/hexstrike-ai/hexstrike-reports/hexstrike.db
#HEXSTRIKE_DB_PATH=hexstrike-reports/hexstrike.db
# Dashboard: GET /dashboard (+ ?token=<WEBHOOK_TOKEN>) ; detail /dashboard/<run_id>

# ============================================================================
# Catatan vLLM: agar function-calling aktif, start server vLLM dengan mis.:
#   vllm serve Qwen/Qwen2.5-7B-Instruct \
#       --enable-auto-tool-choice --tool-call-parser hermes
# Sesuaikan --tool-call-parser dengan model (hermes / llama3_json / mistral / dst).
# ============================================================================
