# ============================================================================
# Build context = REPO ROOT (the Dockerfiles COPY the app from there).
# BuildKit reads this file for `docker build -f deploy/Dockerfile . ` builds
# (per-Dockerfile ignore convention: <dockerfile-path>.dockerignore).
# ============================================================================
.git
.gitignore
*.md

# repo scaffolding not needed inside the image
docker
scripts
deploy
assets

# runtime/output
hexstrike-reports
*.log
.env

# python caches / envs
__pycache__
*.pyc
*.pyo
*.pyd
.venv
venv
hexstrike-dev
hexstrike_env

# editors
.vscode
.idea
